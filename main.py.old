#!/usr/bin/env python3
"""LLM Bias & Fairness Project - Unified Command-Line Interface.

This script provides a unified interface for all project functionality:
- enhance: Enhance single prompts with bias mitigation and diversity
- batch: Process CSV files with enhancement and image generation
- query: Query knowledge graphs for bias and cultural information  
- test: Run various tests and demos

Usage:
    python main.py enhance "a doctor"                    # Enhance a prompt
    python main.py batch prompts.csv                     # Process CSV file
    python main.py query "What stereotypes exist?"       # Query knowledge
    python main.py test --quick                          # Run quick test

For more information:
    python main.py --help
    python main.py enhance --help
    python main.py batch --help
"""

import sys

from src.cli import CLIRunner


def main() -> int:
    """Main entry point for the CLI."""
    runner = CLIRunner()
    return runner.main()


if __name__ == "__main__":
    sys.exit(main())
        description="LLM Bias & Fairness Project - Unified CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )

    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Enable verbose logging"
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # ========================================================================
    # ENHANCE command - Single prompt enhancement
    # ========================================================================
    enhance_parser = subparsers.add_parser(
        "enhance",
        help="Enhance a single prompt for bias mitigation and diversity",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Interactive mode
  python main.py enhance
  
  # Direct enhancement with defaults (dual-pipeline)
  python main.py enhance "a doctor examining a patient"
  
  # Basic enhancement (single-pass, fast)
  python main.py enhance "students in classroom" --mode basic
  
  # Sequential enhancement with custom threshold
  python main.py enhance "engineers working" --mode sequential --threshold 85
  
  # Dual-pipeline with custom thresholds
  python main.py enhance "a teacher" --mode dual-pipeline --bias-threshold 80 --diversity-threshold 85
        """
    )

    enhance_parser.add_argument(
        "prompt",
        nargs="?",
        help="Image prompt to enhance (omit for interactive mode)"
    )

    enhance_parser.add_argument(
        "--mode",
        choices=["basic", "sequential", "dual-pipeline"],
        default="dual-pipeline",
        help="Enhancement mode: basic (fast single-pass), sequential (iterative with diversity), dual-pipeline (bias+diversity scoring, recommended)"
    )

    # Basic mode options
    enhance_parser.add_argument(
        "--bias-top-k",
        type=int,
        default=25,
        help="Number of bias triples to retrieve (default: 25)"
    )

    enhance_parser.add_argument(
        "--cultural-top-k",
        type=int,
        default=25,
        help="Number of cultural triples to retrieve (default: 25)"
    )

    # Sequential mode options
    enhance_parser.add_argument(
        "--threshold",
        type=int,
        default=75,
        help="Diversity threshold for sequential mode (default: 75)"
    )

    enhance_parser.add_argument(
        "--max-iterations",
        type=int,
        default=3,
        help="Maximum enhancement iterations (default: 3)"
    )

    # Dual-pipeline options
    enhance_parser.add_argument(
        "--bias-threshold",
        type=int,
        default=75,
        help="Bias mitigation threshold for dual-pipeline (default: 75)"
    )

    enhance_parser.add_argument(
        "--diversity-threshold",
        type=int,
        default=80,
        help="Diversity threshold for dual-pipeline (default: 80)"
    )

    enhance_parser.add_argument(
        "--use-stereoset",
        action="store_true",
        default=True,
        help="Use StereoSet RAG for bias detection (default: True)"
    )

    enhance_parser.add_argument(
        "--use-diversity-rag",
        action="store_true",
        default=True,
        help="Use CultureBank RAG for diversity (default: True)"
    )

    enhance_parser.add_argument(
        "--use-graphrag",
        action="store_true",
        default=True,
        help="Use GraphRAG for cultural knowledge (default: True)"
    )

    # Cache files
    enhance_parser.add_argument(
        "--cache-file",
        default="embeddings.pkl",
        help="GraphRAG embedding cache file (default: embeddings.pkl)"
    )

    enhance_parser.add_argument(
        "--stereoset-cache",
        default="stereoset_embeddings.pkl",
        help="StereoSet cache file (default: stereoset_embeddings.pkl)"
    )

    enhance_parser.add_argument(
        "--diversity-cache",
        default="diversity_embeddings.pkl",
        help="Diversity cache file (default: diversity_embeddings.pkl)"
    )

    # ========================================================================
    # BATCH command - CSV file processing
    # ========================================================================
    batch_parser = subparsers.add_parser(
        "batch",
        help="Process CSV file with enhancement and image generation",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Basic batch processing
  python main.py batch prompts.csv
  
  # Process with mock images (no API cost)
  python main.py batch prompts.csv --image-generator mock
  
  # Process first 5 rows only
  python main.py batch prompts.csv --max-rows 5
  
  # With visual bias evaluation
  python main.py batch prompts.csv --enable-visual-evaluation
  
  # Custom output directories
  python main.py batch prompts.csv --output-dir my_results --image-dir my_images
  
  # Specify prompt column name
  python main.py batch prompts.csv --prompt-column "description"
        """
    )

    batch_parser.add_argument(
        "input_csv",
        help="Path to input CSV file"
    )

    batch_parser.add_argument(
        "--prompt-column",
        default="prompt",
        help="Name of column containing prompts (default: prompt)"
    )

    batch_parser.add_argument(
        "--output-dir",
        default="batch_results",
        help="Directory for batch results (default: batch_results)"
    )

    batch_parser.add_argument(
        "--image-dir",
        default="generated_images",
        help="Directory for generated images (default: generated_images)"
    )

    batch_parser.add_argument(
        "--output-csv",
        help="Path for output CSV file (default: auto-generated with timestamp)"
    )

    batch_parser.add_argument(
        "--start-row",
        type=int,
        default=0,
        help="Row to start processing from (default: 0)"
    )

    batch_parser.add_argument(
        "--max-rows",
        type=int,
        help="Maximum number of rows to process (default: all)"
    )

    batch_parser.add_argument(
        "--image-generator",
        choices=["dalle3", "mock"],
        default="dalle3",
        help="Image generator type: dalle3 (real images), mock (testing)"
    )

    batch_parser.add_argument(
        "--enable-visual-evaluation",
        action="store_true",
        help="Enable visual bias evaluation on generated images"
    )

    batch_parser.add_argument(
        "--fairface-model",
        help="Path to FairFace model file"
    )

    batch_parser.add_argument(
        "--dlib-model",
        help="Path to dlib shape predictor model"
    )

    batch_parser.add_argument(
        "--no-save-intermediate",
        action="store_true",
        help="Don't save intermediate results during processing"
    )

    # ========================================================================
    # QUERY command - Knowledge graph queries
    # ========================================================================
    query_parser = subparsers.add_parser(
        "query",
        help="Query knowledge graphs for bias and cultural information",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Interactive mode
  python main.py query
  
  # Direct query
  python main.py query "What stereotypes exist about doctors?"
  
  # Query with custom settings
  python main.py query "Cultural practices in Asia" --top-k 10
        """
    )

    query_parser.add_argument(
        "question",
        nargs="?",
        help="Question to ask (omit for interactive mode)"
    )

    query_parser.add_argument(
        "--top-k",
        type=int,
        default=8,
        help="Number of top results to retrieve (default: 8)"
    )

    query_parser.add_argument(
        "--cache-file",
        default="embeddings.pkl",
        help="Embedding cache file (default: embeddings.pkl)"
    )

    # ========================================================================
    # TEST command - Run tests and demos
    # ========================================================================
    test_parser = subparsers.add_parser(
        "test",
        help="Run tests and demos",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Quick test (1 prompt, fast demo)
  python main.py test --quick
  
  # Batch processing test (3 prompts with mock images)
  python main.py test --batch
  
  # Visual evaluation test (3 prompts with visual bias evaluation)
  python main.py test --visual
  
  # All tests
  python main.py test --all
        """
    )

    test_parser.add_argument(
        "--quick",
        action="store_true",
        help="Run quick test (1 prompt, DALL-E 3)"
    )

    test_parser.add_argument(
        "--batch",
        action="store_true",
        help="Test batch processing (3 prompts, mock images)"
    )

    test_parser.add_argument(
        "--visual",
        action="store_true",
        help="Test visual bias evaluation (3 prompts)"
    )

    test_parser.add_argument(
        "--all",
        action="store_true",
        help="Run all tests"
    )

    return parser


# ============================================================================
# ENHANCE command implementation
# ============================================================================

def get_prompt_input(mode: str) -> str:
    """Get prompt from user interactively."""
    mode_names = {
        "basic": "BASIC ENHANCEMENT (Single-Pass)",
        "sequential": "SEQUENTIAL ENHANCEMENT (Iterative with Diversity)",
        "dual-pipeline": "DUAL-PIPELINE ENHANCEMENT (Bias + Diversity)"
    }

    print("\n" + "🎨 " + "=" * 70)
    print(f"   {mode_names.get(mode, 'PROMPT ENHANCEMENT')}")
    print("=" * 74)
    print("Enter an image generation prompt to enhance for diversity and bias mitigation.")
    print("\nExamples:")
    print("  • a doctor examining a patient")
    print("  • students studying in a classroom")
    print("  • a family having dinner")
    print("  • engineers working on a project")
    print("  • people celebrating a festival")
    print("-" * 74)

    while True:
        prompt = input("🎨 Your image prompt: ").strip()
        if prompt:
            return prompt
        print("⚠️  Please enter a non-empty prompt.")


def cmd_enhance(args: argparse.Namespace) -> int:
    """Execute the enhance command."""
    setup_logging(args.verbose)

    # Get prompt
    if args.prompt:
        prompt = args.prompt
        logger.info(f"Enhancing prompt: {prompt}")
    else:
        prompt = get_prompt_input(args.mode)

    try:
        if args.mode == "basic":
            return enhance_basic(prompt, args)
        if args.mode == "sequential":
            return enhance_sequential(prompt, args)
        if args.mode == "dual-pipeline":
            return enhance_dual_pipeline(prompt, args)
        logger.error(f"Unknown enhancement mode: {args.mode}")
        return 1
    except Exception as e:
        logger.error(f"Enhancement failed: {e}")
        if args.verbose:
            import traceback
            traceback.print_exc()
        return 1


def enhance_basic(prompt: str, args: argparse.Namespace) -> int:
    """Basic single-pass enhancement using GraphRAG."""
    import sys
    sys.path.insert(0, str(Path(__file__).parent / "scripts"))

    from enhance_prompt import (
        create_enhancement_prompt,
        format_triples_for_display,
        get_llm_enhancement,
        load_bias_graph,
        load_cultural_graphs,
        retrieve_relevant_triples,
    )

    print("\n🚀 Starting Basic Enhancement...")
    print("=" * 60)

    # Initialize GraphRAG
    graphrag = GraphRAG(cache_file=args.cache_file)

    # Load data
    print("Loading knowledge graphs...")
    if not load_bias_graph(graphrag):
        logger.error("Failed to load bias graph")
        return 1

    if not load_cultural_graphs(graphrag):
        logger.error("Failed to load cultural graphs")
        return 1

    # Retrieve relevant triples
    relevant_triples = retrieve_relevant_triples(
        graphrag, prompt, args.bias_top_k, args.cultural_top_k
    )

    # Display retrieved information
    print(format_triples_for_display(relevant_triples.get("bias", []), "BIAS", 5))
    print(format_triples_for_display(relevant_triples.get("cultural", []), "CULTURAL VALUES", 5))

    # Create enhancement prompt and get LLM response
    enhancement_prompt = create_enhancement_prompt(
        prompt,
        relevant_triples.get("bias", []),
        relevant_triples.get("cultural", [])
    )

    enhanced = get_llm_enhancement(enhancement_prompt, graphrag)

    # Display results
    print("\n" + "=" * 60)
    print("ENHANCEMENT RESULTS")
    print("=" * 60)
    print(f"\n📝 Original Prompt:\n{prompt}")
    print(f"\n✨ Enhanced Prompt:\n{enhanced}")
    print("\n" + "=" * 60)

    return 0


def enhance_sequential(prompt: str, args: argparse.Namespace) -> int:
    """Sequential enhancement with diversity scoring."""
    import sys
    sys.path.insert(0, str(Path(__file__).parent / "scripts"))

    from enhance_prompt_sequential import (
        display_final_results,
        load_bias_graph,
        load_cultural_graphs,
        retrieve_relevant_triples,
        sequential_enhance_prompt,
    )

    print("\n🚀 Starting Sequential Enhancement...")
    print("=" * 60)

    # Initialize GraphRAG
    graphrag = GraphRAG(cache_file=args.cache_file)

    # Load data
    print("Loading knowledge graphs...")
    if not load_bias_graph(graphrag):
        logger.error("Failed to load bias graph")
        return 1

    if not load_cultural_graphs(graphrag):
        logger.error("Failed to load cultural graphs")
        return 1

    # Retrieve relevant triples
    relevant_triples = retrieve_relevant_triples(
        graphrag, prompt, args.bias_top_k, args.cultural_top_k
    )

    # Run sequential enhancement
    final_prompt, iteration_history = sequential_enhance_prompt(
        graphrag,
        prompt,
        relevant_triples.get("bias", []),
        relevant_triples.get("cultural", []),
        args.threshold,
        args.max_iterations
    )

    # Display results
    display_final_results(prompt, final_prompt, iteration_history, relevant_triples)

    return 0


def enhance_dual_pipeline(prompt: str, args: argparse.Namespace) -> int:
    """Dual-pipeline enhancement with bias and diversity scoring."""
    print("\n🚀 Starting Dual-Pipeline Enhancement...")
    print("=" * 60)

    # Load systems
    stereoset_rag, diversity_rag, graphrag = load_enhancement_systems(args)

    if not all([stereoset_rag, diversity_rag, graphrag]):
        logger.error("Failed to load enhancement systems")
        return 1

    # Run enhancement
    results = run_dual_pipeline_enhancement(
        prompt,
        stereoset_rag,
        diversity_rag,
        graphrag,
        args
    )

    # Display results
    display_dual_results(results)

    return 0


# ============================================================================
# BATCH command implementation
# ============================================================================

def cmd_batch(args: argparse.Namespace) -> int:
    """Execute the batch command."""
    setup_logging(args.verbose)

    logger.info(f"Starting batch processing: {args.input_csv}")

    # Check if input file exists
    if not Path(args.input_csv).exists():
        logger.error(f"Input file not found: {args.input_csv}")
        return 1

    try:
        # Initialize batch processor
        processor = BatchProcessor(
            image_generator_type=args.image_generator,
            output_dir=args.output_dir,
            image_output_dir=args.image_dir,
            enable_visual_bias_evaluation=args.enable_visual_evaluation,
            fairface_model_path=args.fairface_model,
            dlib_model_path=args.dlib_model
        )

        # Process CSV
        output_csv_path, results = processor.process_csv(
            input_csv_path=args.input_csv,
            prompt_column=args.prompt_column,
            output_csv_path=args.output_csv,
            start_row=args.start_row,
            max_rows=args.max_rows,
            save_intermediate=not args.no_save_intermediate
        )

        # Print summary
        successful = len([r for r in results if r.error is None])
        total = len(results)

        print(f"\n{'='*60}")
        print("BATCH PROCESSING COMPLETE")
        print(f"{'='*60}")
        print(f"Processed: {successful}/{total} prompts successfully")
        print(f"Results saved to: {output_csv_path}")
        print(f"Images saved to: {args.image_dir}")

        if successful < total:
            print(f"\nWarning: {total - successful} prompts failed to process")
            print("Check the JSON output file for detailed error information")

        return 0

    except Exception as e:
        logger.error(f"Batch processing failed: {e}")
        if args.verbose:
            import traceback
            traceback.print_exc()
        return 1


# ============================================================================
# QUERY command implementation
# ============================================================================

def get_question_input() -> str:
    """Get question from user interactively."""
    print("\n" + "🤔 " + "=" * 50)
    print("   KNOWLEDGE GRAPH QUERY")
    print("=" * 54)
    print("Enter your question about bias, stereotypes, or cultural practices.")
    print("\nExamples:")
    print("  • What racial stereotypes exist about black people?")
    print("  • How are minorities stereotyped in media?")
    print("  • What foods are popular in different cultures?")
    print("  • What cultural practices exist in various countries?")
    print("-" * 54)

    while True:
        question = input("❓ Your question: ").strip()
        if question:
            return question
        print("⚠️  Please enter a non-empty question.")


def cmd_query(args: argparse.Namespace) -> int:
    """Execute the query command."""
    setup_logging(args.verbose)

    # Get question
    if args.question:
        question = args.question
    else:
        question = get_question_input()

    logger.info(f"Querying knowledge graphs: {question}")

    try:
        # Initialize GraphRAG
        graphrag = GraphRAG(cache_file=args.cache_file)

        # Test bias data
        print("\n" + "=" * 60)
        print("QUERYING BIAS DATA")
        print("=" * 60)

        bias_file = "data/biases/ADV_GRAPH_20240119 - ADV_GRAPH_20240119.csv"
        if Path(bias_file).exists():
            parser = DataParserFactory.create_parser(bias_file)
            graph = graphrag.add_graph("bias_graph", parser)
            logger.info(f"Loaded bias graph: {graph}")

            try:
                answer = graphrag.answer_question("bias_graph", question, top_k=args.top_k)
                print(f"\n💡 Answer:\n{answer}")
            except Exception as e:
                logger.error(f"Query failed: {e}")
        else:
            logger.warning(f"Bias file not found: {bias_file}")

        # Test cultural data
        print("\n" + "=" * 60)
        print("QUERYING CULTURAL VALUES DATA")
        print("=" * 60)

        cultural_dir = Path("data/cultural_values")
        if cultural_dir.exists():
            txt_files = list(cultural_dir.glob("*.txt"))[:3]  # First 3 files

            for file_path in txt_files:
                country = file_path.stem.replace(" triples", "").replace("_", " ").title()
                graph_name = f"cultural_{file_path.stem.replace(' ', '_').lower()}"

                print(f"\n--- Querying {country} Cultural Data ---")

                try:
                    parser = DataParserFactory.create_parser(file_path)
                    graph = graphrag.add_graph(graph_name, parser)
                    logger.info(f"Loaded graph: {graph}")

                    answer = graphrag.answer_question(graph_name, question, top_k=5)
                    print(f"\n💡 Answer:\n{answer}")
                except Exception as e:
                    logger.error(f"Query failed: {e}")
        else:
            logger.warning(f"Cultural values directory not found: {cultural_dir}")

        return 0

    except Exception as e:
        logger.error(f"Query failed: {e}")
        if args.verbose:
            import traceback
            traceback.print_exc()
        return 1


# ============================================================================
# TEST command implementation
# ============================================================================

def cmd_test(args: argparse.Namespace) -> int:
    """Execute the test command."""
    setup_logging(args.verbose)

    # Determine which tests to run
    run_quick = args.quick or args.all
    run_batch = args.batch or args.all
    run_visual = args.visual or args.all

    # If no specific test selected, show help
    if not (run_quick or run_batch or run_visual):
        logger.error("Please specify a test type: --quick, --batch, --visual, or --all")
        return 1

    results = []

    if run_quick:
        logger.info("Running quick test...")
        results.append(("Quick Test", test_quick()))

    if run_batch:
        logger.info("Running batch test...")
        results.append(("Batch Test", test_batch()))

    if run_visual:
        logger.info("Running visual evaluation test...")
        results.append(("Visual Test", test_visual()))

    # Print summary
    print("\n" + "=" * 60)
    print("TEST SUMMARY")
    print("=" * 60)
    for test_name, result in results:
        status = "✅ PASSED" if result == 0 else "❌ FAILED"
        print(f"{test_name}: {status}")

    # Return 0 if all passed, 1 if any failed
    return 0 if all(r == 0 for _, r in results) else 1


def test_quick() -> int:
    """Run quick test (1 prompt, DALL-E 3)."""
    print("\n🚀 Quick Pipeline Test")
    print("=" * 50)

    input_csv = "test_prompts.csv"
    if not Path(input_csv).exists():
        logger.error(f"Test file not found: {input_csv}")
        return 1

    try:
        processor = BatchProcessor(
            image_generator_type="dalle3",
            output_dir="quick_test_results",
            image_output_dir="quick_test_images"
        )

        output_csv_path, results = processor.process_csv(
            input_csv_path=input_csv,
            prompt_column="prompt",
            max_rows=1,
            save_intermediate=True
        )

        result = results[0]
        print(f"\n📝 Original: {result.original_prompt}")
        if result.enhanced_prompt:
            print(f"✨ Enhanced: {result.enhanced_prompt[:200]}...")
            print(f"📊 Scores: Bias={result.bias_score}/100, Diversity={result.diversity_score}/100")
        if result.error:
            print(f"❌ Error: {result.error}")
            return 1

        print(f"\n💾 Results: {output_csv_path}")
        return 0

    except Exception as e:
        logger.error(f"Quick test failed: {e}")
        return 1


def test_batch() -> int:
    """Test batch processing (3 prompts, mock images)."""
    print("\n🧪 Batch Processing Test")
    print("=" * 50)

    input_csv = "test_prompts.csv"
    if not Path(input_csv).exists():
        logger.error(f"Test file not found: {input_csv}")
        return 1

    try:
        processor = BatchProcessor(
            image_generator_type="mock",
            output_dir="test_results",
            image_output_dir="test_images"
        )

        output_csv_path, results = processor.process_csv(
            input_csv_path=input_csv,
            prompt_column="prompt",
            max_rows=3,
            save_intermediate=True
        )

        successful = len([r for r in results if r.error is None])
        print(f"\nProcessed: {successful}/{len(results)} prompts")
        print(f"Results: {output_csv_path}")

        return 0 if successful == len(results) else 1

    except Exception as e:
        logger.error(f"Batch test failed: {e}")
        return 1


def test_visual() -> int:
    """Test visual bias evaluation (3 prompts)."""
    print("\n🔍 Visual Bias Evaluation Test")
    print("=" * 50)

    input_csv = "test_prompts.csv"
    if not Path(input_csv).exists():
        logger.error(f"Test file not found: {input_csv}")
        return 1

    try:
        processor = BatchProcessor(
            image_generator_type="dalle3",
            output_dir="visual_bias_test_results",
            image_output_dir="visual_bias_test_images",
            enable_visual_bias_evaluation=True
        )

        output_csv_path, results = processor.process_csv(
            input_csv_path=input_csv,
            prompt_column="prompt",
            max_rows=3,
            save_intermediate=True
        )

        successful = len([r for r in results if r.error is None])
        print(f"\nProcessed: {successful}/{len(results)} prompts")
        print(f"Results: {output_csv_path}")

        evaluation_dir = Path("visual_bias_test_results") / "visual_bias_evaluation"
        if evaluation_dir.exists():
            print(f"Visual evaluation results: {evaluation_dir}")

        return 0 if successful == len(results) else 1

    except Exception as e:
        logger.error(f"Visual test failed: {e}")
        return 1


# ============================================================================
# Main entry point
# ============================================================================

def main() -> int:
    """Main entry point."""
    parser = create_parser()
    args = parser.parse_args()

    # If no command specified, show help
    if not args.command:
        parser.print_help()
        return 1

    # Route to appropriate command handler
    if args.command == "enhance":
        return cmd_enhance(args)
    if args.command == "batch":
        return cmd_batch(args)
    if args.command == "query":
        return cmd_query(args)
    if args.command == "test":
        return cmd_test(args)
    logger.error(f"Unknown command: {args.command}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
